---
import { pricingPlans } from "../data/pricing";
---

<dialog class="pricing-dialog" id="pricing-modal">
  <div class="pricing-dialog-inner">
    <div class="pricing-dialog-header">
      <div>
        <span class="eyebrow">Pricing snapshot</span>
        <h2>Choose the GymOS plan that matches your operating complexity.</h2>
      </div>
      <button class="dialog-close" type="button" data-close-pricing-modal aria-label="Close pricing modal">
        Close
      </button>
    </div>

    <div class="pricing-modal-grid">
      {pricingPlans.map((plan) => (
        <article class:list={["price-card", plan.code === "growth" && "price-card-highlight"]}>
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;">
              <span class="price-tier">{plan.label}</span>
              {plan.highlight ? <span class="pricing-badge-save">{plan.highlight}</span> : null}
            </div>
            <h3>{plan.monthlyPriceLabel}<span>{plan.monthlySuffix}</span></h3>
            <p>{plan.summary}</p>
            <ul>
              {plan.features.map((feature) => <li>{feature}</li>)}
            </ul>
            <ul style="margin-top: 0.85rem; opacity: 0.82;">
              {plan.limits.map((limit) => <li>{limit}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</dialog>

<script is:inline>
  const pricingModal = document.getElementById("pricing-modal");
  const openPricingButtons = document.querySelectorAll("[data-open-pricing-modal]");
  const closePricingButtons = document.querySelectorAll("[data-close-pricing-modal]");

  if (pricingModal instanceof HTMLDialogElement) {
    openPricingButtons.forEach((button) => {
      button.addEventListener("click", () => pricingModal.showModal());
    });

    closePricingButtons.forEach((button) => {
      button.addEventListener("click", () => pricingModal.close());
    });

    pricingModal.addEventListener("click", (event) => {
      const bounds = pricingModal.getBoundingClientRect();
      const clickedInDialog =
        bounds.top <= event.clientY &&
        event.clientY <= bounds.top + bounds.height &&
        bounds.left <= event.clientX &&
        event.clientX <= bounds.left + bounds.width;

      if (!clickedInDialog) {
        pricingModal.close();
      }
    });
  }
</script>
