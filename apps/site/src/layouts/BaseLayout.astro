---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "GymOS | Gym Management Software",
  description = "GymOS helps gym operators manage members, branches, billing, staff, plans, and day-to-day operations from one system.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Favicon SVG -->
    <link rel="icon" type="image/svg+xml" href="/assets/white-logo.svg" />
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body>
    <div class="background-grid-container"></div>
    <canvas id="liquid-shader-canvas"></canvas>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <!-- Scroll to Top Button -->
    <button id="scroll-to-top" class="scroll-to-top-btn" aria-label="Scroll to top" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 16px; height: 16px;"><polyline points="18 15 12 9 6 15"></polyline></svg>
    </button>

    <script is:inline>
      // Initialize Lucide icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }

      // Header Scroll border toggle
      const header = document.querySelector(".site-header");
      const handleScrollHeader = () => {
        if (header) {
          if (window.scrollY > 20) {
            header.classList.add("scrolled");
          } else {
            header.classList.remove("scrolled");
          }
        }
      };
      window.addEventListener("scroll", handleScrollHeader);
      handleScrollHeader();

      // Scroll to Top Logic
      const scrollTopBtn = document.getElementById("scroll-to-top");
      if (scrollTopBtn) {
        window.addEventListener("scroll", () => {
          if (window.scrollY > 300) {
            scrollTopBtn.classList.add("visible");
          } else {
            scrollTopBtn.classList.remove("visible");
          }
        });
        
        scrollTopBtn.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }
    </script>
    <!-- Three.js Liquid Shader Background Script -->
    <script>
      import * as THREE from 'three';

      const initLiquidShader = () => {
        const canvas = document.getElementById('liquid-shader-canvas') as HTMLCanvasElement;
        if (!canvas) return;

        const scene = new THREE.Scene();
        const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setSize(window.innerWidth, window.innerHeight);

        const uniforms = {
          uTime: { value: 0 },
          uResolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },
          uMouse: { value: new THREE.Vector2(0.5, 0.5) },
          uTargetMouse: { value: new THREE.Vector2(0.5, 0.5) }
        };

        const vertexShader = `
          varying vec2 vUv;
          void main() {
            vUv = uv;
            gl_Position = vec4(position, 1.0);
          }
        `;

        const fragmentShader = `
          uniform float uTime;
          uniform vec2 uResolution;
          uniform vec2 uMouse;
          varying vec2 vUv;

          // Simplex 2D noise helper functions
          vec3 permute(vec3 x) { return mod(((x*34.0)+1.0)*x, 289.0); }
          float snoise(vec2 v){
            const vec4 C = vec4(0.211324865405187, 0.366025403784439,
                             -0.577350269189626, 0.024390243902439);
            vec2 i  = floor(v + dot(v, C.yy) );
            vec2 x0 = v -   i + dot(i, C.xx);
            vec2 i1;
            i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
            vec4 x12 = x0.xyxy + C.xxzz;
            x12.xy -= i1;
            i = mod(i, 289.0);
            vec3 p = permute( permute( i.y + vec3(0.0, i1.y, 1.0 ))
            + i.x + vec3(0.0, i1.x, 1.0 ));
            vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);
            m = m*m ;
            m = m*m ;
            vec3 x = 2.0 * fract(p * C.www) - 1.0;
            vec3 h = abs(x) - 0.5;
            vec3 ox = floor(x + 0.5);
            vec3 a0 = x - ox;
            m *= 1.79284291400159 - 0.85373472095314 * ( a0*a0 + h*h );
            vec3 g;
            g.x  = a0.x  * x0.x  + h.x  * x0.y;
            g.yz = a0.yz * x12.xz + h.yz * x12.yw;
            return 130.0 * dot(m, g);
          }

          void main() {
            vec2 st = gl_FragCoord.xy / uResolution.xy;
            st.x *= uResolution.x / uResolution.y;

            // Enhanced interactive mouse displacement
            vec2 mouseSt = uMouse;
            mouseSt.x *= uResolution.x / uResolution.y;
            float dist = distance(st, mouseSt);
            float mouseDisplace = smoothstep(0.75, 0.0, dist) * 0.12;
            float mouseRipple = sin(dist * 18.0 - uTime * 2.5) * smoothstep(0.5, 0.0, dist) * 0.08;

            float t = uTime * 0.22;

            // 8-9 Layered Smooth Flowing Sine Waves
            float wave1 = sin(st.x * 2.8 + t + mouseDisplace) * 0.14;
            float wave2 = cos(st.y * 3.2 - t * 0.7 + wave1) * 0.11;
            float wave3 = sin((st.x + st.y) * 2.2 + t * 0.55 + mouseDisplace + mouseRipple) * 0.13;
            float wave4 = cos(st.x * 2.0 - st.y * 2.5 + t * 0.45) * 0.09;
            float wave5 = sin(length(st - vec2(0.5, 0.5)) * 4.0 - t * 0.35 + mouseDisplace) * 0.09;
            float wave6 = cos(st.x * 3.8 + st.y * 1.5 - t * 0.6 + mouseRipple) * 0.07;
            float wave7 = sin(st.y * 4.2 + t * 0.5 - wave2) * 0.06;
            float wave8 = cos(length(st - mouseSt) * 5.0 - t * 0.8 + mouseDisplace) * 0.08;

            float combinedWave = wave1 + wave2 + wave3 + wave4 + wave5 + wave6 + wave7 + wave8;

            // Muted, low vibrancy subtle dark palette matching dark mode (#c6f831 accent glow)
            vec3 baseBg = vec3(0.07, 0.07, 0.07); // Dark neutral gray
            vec3 waveTint = vec3(0.12, 0.17, 0.10); // Subtle dark olive-lime tint
            vec3 waveGlow = vec3(0.28, 0.36, 0.11); // Low vibrancy soft lime accent hint

            vec3 color = mix(baseBg, waveTint, smoothstep(-0.35, 0.35, combinedWave));
            color += waveGlow * pow(smoothstep(-0.1, 0.45, combinedWave), 2.2) * 0.3;

            // Subtle opacity so background grid pattern is smoothly visible beneath
            gl_FragColor = vec4(color, 0.55);
          }
        `;

        const material = new THREE.ShaderMaterial({
          uniforms,
          vertexShader,
          fragmentShader,
          transparent: true,
          depthWrite: false,
        });

        const plane = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material);
        scene.add(plane);

        const handleResize = () => {
          renderer.setSize(window.innerWidth, window.innerHeight);
          uniforms.uResolution.value.set(window.innerWidth, window.innerHeight);
        };
        window.addEventListener('resize', handleResize);

        window.addEventListener('mousemove', (e) => {
          uniforms.uTargetMouse.value.set(
            e.clientX / window.innerWidth,
            1.0 - (e.clientY / window.innerHeight)
          );
        });

        const clock = new THREE.Clock();

        const animate = () => {
          requestAnimationFrame(animate);
          uniforms.uTime.value = clock.getElapsedTime();
          // Faster mouse lerp for responsive fluid feedback
          uniforms.uMouse.value.lerp(uniforms.uTargetMouse.value, 0.065);
          renderer.render(scene, camera);
        };

        animate();
      };

      // Init on page load & Astro client navigation transitions
      document.addEventListener('astro:page-load', initLiquidShader);
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initLiquidShader();
      } else {
        document.addEventListener('DOMContentLoaded', initLiquidShader);
      }
    </script>
  </body>
</html>
