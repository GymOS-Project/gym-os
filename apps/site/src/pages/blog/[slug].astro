---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | GymOS`} description={post.data.description}>
  <div class="article-wrap">
    <div class="container article-stack">
      <section class="article-hero page-hero">
        <span class="eyebrow">{post.data.category}</span>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="meta-row">
          <span>{post.data.readingTime}</span>
          <span>{post.data.publishedAt.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}</span>
          <a class="meta-link" href="/blog">Back to blog</a>
        </div>
      </section>

      <article class="article-shell">
        <Content />
      </article>
    </div>
  </div>
</BaseLayout>
