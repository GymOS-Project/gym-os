    const iconMap = {
      'user-check': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>`,
      'send': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>`,
      'dumbbell': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><path d="M6 5v14"/><path d="M18 5v14"/><path d="M6 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h3"/><path d="M18 8h3a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-3"/><path d="M6 5h12"/><path d="M6 19h12"/><path d="M10 5v14"/><path d="M14 5v14"/></svg>`
    };
    document.querySelectorAll('.demo-icon-wrap i[data-lucide]').forEach(function(el) {
      const name = el.getAttribute('data-lucide');
      if (name && iconMap[name]) {
        el.outerHTML = iconMap[name];
      }
    });
  })();

  if (demoButtons.length > 0 && demoScreen) {
    demoButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        demoButtons.forEach(function(btn) { btn.classList.remove('active'); });
        button.classList.add('active');
        const step = button.getAttribute('data-demo-step');
        if (demoStates[step]) {
          demoScreen.innerHTML = demoStates[step];
        }
      });
    });
  }

  // Pricing Toggle Logic
  const monthlyToggle = document.getElementById('billing-monthly');
  const yearlyToggle  = document.getElementById('billing-yearly');
  const priceStarter  = document.getElementById('price-starter');
  const priceGrowth   = document.getElementById('price-growth');
  const priceScale    = document.getElementById('price-scale');

  if (monthlyToggle && yearlyToggle && priceStarter && priceGrowth && priceScale) {
    monthlyToggle.addEventListener('click', function() {
      monthlyToggle.classList.add('active');
      yearlyToggle.classList.remove('active');
      priceStarter.innerHTML = `${pricingToggleValues.monthly.starter.label}<span>${pricingToggleValues.monthly.starter.suffix}</span>`;
      priceGrowth.innerHTML  = `${pricingToggleValues.monthly.growth.label}<span>${pricingToggleValues.monthly.growth.suffix}</span>`;
      priceScale.innerHTML   = `${pricingToggleValues.monthly.scale.label}<span>${pricingToggleValues.monthly.scale.suffix}</span>`;
    });
    yearlyToggle.addEventListener('click', function() {
      yearlyToggle.classList.add('active');
      monthlyToggle.classList.remove('active');
      priceStarter.innerHTML = `${pricingToggleValues.yearly.starter.label}<span>${pricingToggleValues.yearly.starter.suffix}</span>`;
      priceGrowth.innerHTML  = `${pricingToggleValues.yearly.growth.label}<span>${pricingToggleValues.yearly.growth.suffix}</span>`;
      priceScale.innerHTML   = `${pricingToggleValues.yearly.scale.label}<span>${pricingToggleValues.yearly.scale.suffix}</span>`;
    });
  }

  // FAQ Custom Accordion — one open at a time, + / - icons
  (function initFaq() {
    const items = document.querySelectorAll('#faq-list .faq-item');
    items.forEach(function(item) {
      const btn   = item.querySelector('.faq-btn');
      const panel = item.querySelector('.faq-panel');
      const icon  = item.querySelector('.faq-icon');
      if (!btn || !panel || !icon) return;

      btn.addEventListener('click', function() {
        const isOpen = item.getAttribute('data-open') === 'true';
        // Close all first
        items.forEach(function(it) {
          it.setAttribute('data-open', 'false');
          const p = it.querySelector('.faq-panel');
          const ic = it.querySelector('.faq-icon');
          const b  = it.querySelector('.faq-btn');
          if (p)  { p.style.maxHeight = '0'; }
          if (ic) { ic.innerHTML = '&#43;'; }
          if (b)  { b.setAttribute('aria-expanded', 'false'); }
          it.classList.remove('faq-item--open');
        });
        // If was closed, open it
        if (!isOpen) {
          item.setAttribute('data-open', 'true');
          item.classList.add('faq-item--open');
          panel.style.maxHeight = panel.scrollHeight + 'px';
          icon.innerHTML = '&#8722;';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>
