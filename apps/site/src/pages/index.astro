---
import PricingModal from "../components/PricingModal.astro";
import { pricingPlans, pricingToggleValues } from "../data/pricing";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <!-- Centered Hero Section with Three.js Background -->
  <section class="hero-panel reveal">
    <!-- Interactive 3D Particles Canvas -->
    <canvas id="hero-canvas"></canvas>
    
    <div class="container">
      <div class="hero-copy-centered">
        <span class="eyebrow"><i data-lucide="sparkles" style="width: 12px; height: 12px; margin-right: 4px; vertical-align: middle;"></i> Gym Management Operating System</span>
        <h1>The calmer way to run <br/><span class="gradient-text">ambitious gym brands.</span></h1>
        <p class="lead-copy">
          GymOS unifies membership contracts, automated UPI billing pipelines, biometric turnstile scans, and trainer routines into a singular calm control center. Designed for operators who have outgrown spreadsheet chaos.
        </p>

        <div class="hero-actions">
          <a class="button button-glow-effect" href="https://gym-os.pages.dev/">Start 14 days free trial</a>
          <a class="button button-ghost" href="#pricing">View Pricing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Gym-related Features Scrolling Ticker -->
  <section class="ticker-wrap reveal">
    <div class="ticker-track">
      <!-- Direct integrations list -->
      <div class="ticker-item"><i data-lucide="fingerprint"></i> Biometric Integration</div>
      <div class="ticker-item"><i data-lucide="bell"></i> SMS & WhatsApp Reminders</div>
      <div class="ticker-item"><i data-lucide="credit-card"></i> UPI Invoice Automation</div>
      <div class="ticker-item"><i data-lucide="dumbbell"></i> Trainer Exercise Portals</div>
      <div class="ticker-item"><i data-lucide="bar-chart-3"></i> Multi-Branch Analytics</div>
      <div class="ticker-item"><i data-lucide="lock"></i> Access Control Turnstiles</div>
      <!-- Duplicate integrations to ensure infinite scrolling -->
      <div class="ticker-item"><i data-lucide="fingerprint"></i> Biometric Integration</div>
      <div class="ticker-item"><i data-lucide="bell"></i> SMS & WhatsApp Reminders</div>
      <div class="ticker-item"><i data-lucide="credit-card"></i> UPI Invoice Automation</div>
      <div class="ticker-item"><i data-lucide="dumbbell"></i> Trainer Exercise Portals</div>
      <div class="ticker-item"><i data-lucide="bar-chart-3"></i> Multi-Branch Analytics</div>
      <div class="ticker-item"><i data-lucide="lock"></i> Access Control Turnstiles</div>
    </div>
  </section>

  <!-- Bento Minimalist Feature Grid Section -->
  <section class="section-block reveal">
    <div class="container">
      <div class="section-intro">
        <div>
          <span class="eyebrow"><i data-lucide="layers" style="width: 12px; height: 12px; margin-right: 4px; vertical-align: middle;"></i> Core System Modules</span>
          <h2>A robust operating layer designed for execution.</h2>
        </div>
        <p>
          GymOS maps directly to your physical operations, replacing scattered spreadsheets, fragmented notebooks, and insecure group chats.
        </p>
      </div>

      <div class="bento-grid">
        <!-- Minimalist Feature 1 -->
        <article class="bento-card bento-card-large">
          <div>
            <div class="icon-wrap">
              <i data-lucide="users"></i>
            </div>
            <h3>Unified Member Directory</h3>
            <p>
              Keep your team aligned with central profiles. Manage membership details, biometric scanner logs, payment histories, and trainer notes inside a single, clean workspace.
            </p>
          </div>
        </article>

        <!-- Minimalist Feature 2 -->
        <article class="bento-card">
          <div>
            <div class="icon-wrap">
              <i data-lucide="credit-card"></i>
            </div>
            <h3>Smart Invoicing</h3>
            <p>
              Generate secure UPI/card billing links, automate invoices, track discounts, and manage coupon campaigns with zero manual entry.
            </p>
          </div>
        </article>

        <!-- Minimalist Feature 3 -->
        <article class="bento-card">
          <div>
            <div class="icon-wrap">
              <i data-lucide="clipboard-list"></i>
            </div>
            <h3>Trainer Portal</h3>
            <p>
              Empower trainers to build and assign custom workout splits and calorie-tracked meal diets, delivered instantly to member logs.
            </p>
          </div>
        </article>

        <!-- Minimalist Feature 4 -->
        <article class="bento-card bento-card-large">
          <div>
            <div class="icon-wrap">
              <i data-lucide="shield"></i>
            </div>
            <h3>Granular Role & Branch Controls</h3>
            <p>
              Protect gym metrics. Define staff permissions so front-desk agents, head trainers, and general managers only see the tools they need. Seamlessly scale oversight across multiple gym branches.
            </p>
          </div>
        </article>
      </div>
    </div>
