  <!-- Pricing Section -->
  <section class="section-block reveal" id="pricing">
    <div class="container">
      <div class="pricing-summary">
        <div>
          <span class="eyebrow"><i data-lucide="tag" style="width: 12px; height: 12px; margin-right: 4px; vertical-align: middle;"></i> Pricing Setup</span>
          <h2>Three clear plans built around core operations, growth workflows, and scale unlocks.</h2>
          <p style="color: var(--muted); margin-top: 0.4rem; font-size: 0.85rem;">All plans include a 14-day free trial and the daily fundamentals gyms expect.</p>
        </div>
        
        <!-- Toggle Switch -->
        <div class="price-toggle-container">
          <button class="price-toggle-btn active" id="billing-monthly">Monthly</button>
          <button class="price-toggle-btn" id="billing-yearly">Yearly</button>
        </div>
      </div>

      <div class="pricing-grid">
        {pricingPlans.map((plan) => (
          <article class:list={["price-card", plan.code === "growth" && "price-card-highlight"]}>
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;">
                <span class="price-tier">{plan.label}</span>
                {plan.highlight ? <span class="pricing-badge-save">{plan.highlight}</span> : null}
              </div>
              <h3 id={`price-${plan.code}`}>{plan.monthlyPriceLabel}<span>{plan.monthlySuffix}</span></h3>
              <p style="font-size: 0.85rem; color: var(--muted); margin-bottom: 1.25rem;">{plan.summary}</p>
              <hr style="border: 0; border-top: 1px solid var(--line); margin-bottom: 1.25rem;" />
              <ul>
                {plan.features.map((feature) => <li><i data-lucide="check"></i> {feature}</li>)}
              </ul>
              <ul style="margin-top: 1rem; opacity: 0.82;">
                {plan.limits.map((limit) => <li><i data-lucide="check"></i> {limit}</li>)}
              </ul>
            </div>
            <a class:list={["button", plan.code === "growth" ? undefined : "button-ghost"]} href="https://gym-os.pages.dev/" style="margin-top: 1.5rem; width: 100%;">{plan.ctaLabel}</a>
          </article>
