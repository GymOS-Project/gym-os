      <a class="button button-glow-effect" href="https://gym-os.pages.dev/">Start 14 days free trial</a>
    </div>
  </section>

</BaseLayout>

<!-- Lenis Smooth Scroll -->
<script is:inline define:vars={{ pricingToggleValues }}>
  (function () {
    // Lightweight smooth scroll using requestAnimationFrame — no external dep needed
    // We implement a minimal Lenis-style lerp scroll in pure JS
    let currentY = window.scrollY;
    let targetScrollY = window.scrollY;
    let ease = 0.088;
    let isAnimating = false;
    let lastKnownY = window.scrollY;

    // Override native scroll
    document.documentElement.style.scrollBehavior = 'auto';

    function maxScrollY() {
      return Math.max(0, document.body.scrollHeight - window.innerHeight);
    }

    function clampScrollY(value) {
      return Math.max(0, Math.min(value, maxScrollY()));
    }

    function syncScrollState() {
      currentY = window.scrollY;
      targetScrollY = window.scrollY;
      lastKnownY = window.scrollY;
    }

    function getAnchorTarget(element) {
      const header = document.querySelector('.site-header');
      const headerOffset = header ? header.getBoundingClientRect().height + 16 : 0;
      return clampScrollY(element.getBoundingClientRect().top + window.scrollY - headerOffset);
    }

    document.addEventListener('click', function (e) {
      if (!(e.target instanceof Element)) return;
      const link = e.target.closest('a[href^="#"]');
      if (!link) return;

      const hash = link.getAttribute('href');
      if (!hash || hash === '#') return;

      const target = document.querySelector(hash);
      if (!target) return;

      e.preventDefault();
      targetScrollY = getAnchorTarget(target);
      currentY = window.scrollY;
      history.pushState(null, '', hash);
      if (!isAnimating) startAnimation();
    });

    window.addEventListener('wheel', function (e) {
      e.preventDefault();
      if (Math.abs(window.scrollY - lastKnownY) > 2 && !isAnimating) {
        syncScrollState();
      }
      targetScrollY = clampScrollY(targetScrollY + e.deltaY * 0.9);
      if (!isAnimating) startAnimation();
    }, { passive: false });

    window.addEventListener('scroll', function () {
      if (!isAnimating) {
        syncScrollState();
      }
      lastKnownY = window.scrollY;
    }, { passive: true });

    window.addEventListener('hashchange', function () {
      requestAnimationFrame(syncScrollState);
    });

    window.addEventListener('resize', function () {
      targetScrollY = clampScrollY(targetScrollY);
      currentY = clampScrollY(currentY);
    });

    function startAnimation() {
      isAnimating = true;
      requestAnimationFrame(loop);
    }

    function loop() {
      currentY += (targetScrollY - currentY) * ease;
      window.scrollTo(0, currentY);
      if (Math.abs(targetScrollY - currentY) > 0.5) {
        requestAnimationFrame(loop);
      } else {
        window.scrollTo(0, targetScrollY);
        currentY = targetScrollY;
        isAnimating = false;
      }
    }
  })();
</script>

<!-- Viewport-triggered card reveals -->
<script is:inline>
  (function () {
    const revealSelector = [
      '.hero-metrics > div',
      '.bento-card',
      '.demo-sidebar',
      '.demo-screen',
      '.pricing-grid .price-card',
      '.content-hub-shell',
      '.resource-grid .list-card',
      '.pricing-dialog .price-card'
    ].join(',');

    const revealCards = Array.from(document.querySelectorAll(revealSelector));

    if (!('IntersectionObserver' in window)) {
      revealCards.forEach(function (card) {
        card.classList.add('card-visible');
      });
      return;
    }

    const observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;

        entry.target.classList.add('card-visible');
        observer.unobserve(entry.target);
      });
    }, {
      threshold: 0.18,
      rootMargin: '0px 0px -8% 0px'
    });

    revealCards.forEach(function (card) {
      observer.observe(card);
    });
  })();
</script>

