    <div class="container">
      <div class="section-intro">
        <div>
          <span class="eyebrow"><i data-lucide="play" style="width: 12px; height: 12px; margin-right: 4px; vertical-align: middle;"></i> Interactive Playground</span>
          <h2>See operations execute in real-time.</h2>
        </div>
        <p>
          Click through the operational triggers below to see how GymOS processes workflows and provides immediate feedback.
        </p>
      </div>

      <div class="demo-container">
        <!-- Interactive Controls -->
        <div class="demo-sidebar">
          <button class="demo-btn active" data-demo-step="checkin">
            <div class="demo-icon-wrap"><i data-lucide="user-check"></i></div>
            <div>
              <div style="font-weight: 700; font-size: 0.9rem;">Process Check-in</div>
              <div style="font-size: 0.75rem; color: var(--muted); font-weight: 400; margin-top: 0.1rem;">Scan biometric entry pass</div>
            </div>
          </button>
          
          <button class="demo-btn" data-demo-step="invoice">
            <div class="demo-icon-wrap"><i data-lucide="send"></i></div>
            <div>
              <div style="font-weight: 700; font-size: 0.9rem;">Send Renewal Invoice</div>
              <div style="font-size: 0.75rem; color: var(--muted); font-weight: 400; margin-top: 0.1rem;">Dispatch SMS payment link</div>
            </div>
          </button>
          
          <button class="demo-btn" data-demo-step="workout">
            <div class="demo-icon-wrap"><i data-lucide="dumbbell"></i></div>
            <div>
              <div style="font-weight: 700; font-size: 0.9rem;">Assign Workout Plan</div>
              <div style="font-size: 0.75rem; color: var(--muted); font-weight: 400; margin-top: 0.1rem;">Push workout routine to mobile</div>
            </div>
          </button>
        </div>

        <!-- Terminal Output screen -->
        <div class="demo-screen">
          <div class="demo-screen-dots">
            <span></span><span></span><span></span>
          </div>
          <div class="demo-content" id="demo-output-screen">
            <!-- Default Content: Check-in State -->
