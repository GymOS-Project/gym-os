---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Terms of Service | GymOS" description="GymOS terms of service covering account usage, responsibilities, and service limitations.">
  <div class="page-wrap">
    <div class="container legal-stack">
      <section class="page-hero">
        <span class="eyebrow">Legal</span>
        <h1>Terms of Service</h1>
        <p>These terms govern access to and use of the GymOS software and services.</p>
      </section>

      <article class="legal-copy">
        <h2>Use of service</h2>
        <p>
          GymOS is provided for lawful business use related to gym operations,
          member management, staff workflows, and related administrative activities.
        </p>

        <h2>Account responsibility</h2>
        <p>
          Customers are responsible for maintaining account security, assigning staff
          access appropriately, and ensuring data entered into the platform is lawful.
        </p>

        <h2>Availability</h2>
        <p>
          We aim to provide reliable service but do not guarantee uninterrupted
          availability at all times. Maintenance, updates, or external factors may
          affect access temporarily.
        </p>

        <h2>Fees and changes</h2>
        <p>
          Paid plans, setup fees, or custom rollout terms may be defined separately in
          commercial agreements or order documentation.
        </p>

        <h2>Contact</h2>
        <p>Questions about these terms can be sent to `hello@gymos.app`.</p>
      </article>
    </div>
  </div>
</BaseLayout>
