---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | GymOS" description="Learn what GymOS is, who it serves, and the services behind the software rollout.">
  <div class="page-wrap">
    <div class="container page-stack">
      <section class="page-hero">
        <span class="eyebrow">About GymOS</span>
        <h1>Designed for gyms that need sharper operational discipline.</h1>
        <p>
          GymOS is a gym management platform focused on the workflows that create
          operational clarity: members, packages, collections, staff permissions,
          attendance, and branch-level visibility.
        </p>
      </section>

      <section class="section-shell">
        <div class="section-intro">
          <div>
            <span class="eyebrow">What we offer</span>
            <h2>Software plus rollout support.</h2>
          </div>
          <p>
            We help gyms move from fragmented admin habits into structured operating
            workflows that are easier to train, review, and scale.
          </p>
        </div>

        <div class="service-grid">
          <article class="service-card">
            <h3>Platform setup</h3>
            <p>Initial configuration for single-location or branch-based gym operations.</p>
          </article>
          <article class="service-card">
            <h3>Operational migration</h3>
            <p>Support for moving member records, package information, and billing habits into GymOS.</p>
          </article>
          <article class="service-card">
            <h3>Team enablement</h3>
            <p>Role guidance and workflow walkthroughs so the software becomes part of daily execution.</p>
          </article>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
