---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy Policy | GymOS" description="GymOS privacy policy covering data collection, usage, retention, and contact details.">
  <div class="page-wrap">
    <div class="container legal-stack">
      <section class="page-hero">
        <span class="eyebrow">Legal</span>
        <h1>Privacy Policy</h1>
        <p>This page explains how GymOS collects, uses, and protects information.</p>
      </section>

      <article class="legal-copy">
        <h2>Information we collect</h2>
        <p>
          We may collect contact information, gym business details, account data,
          and operational records required to provide the GymOS platform.
        </p>

        <h2>How we use information</h2>
        <p>
          Data is used to operate the service, manage access, support onboarding,
          improve workflows, and communicate about product usage or support matters.
        </p>

        <h2>Retention and access</h2>
        <p>
          We retain information for as long as needed to provide the service,
          comply with legal obligations, and resolve operational or security issues.
        </p>

        <h2>Security</h2>
        <p>
          We take reasonable technical and operational measures to protect data, but
          no transmission or storage method is guaranteed to be fully secure.
        </p>

        <h2>Contact</h2>
        <p>For privacy-related questions, contact `hello@gymos.app`.</p>
      </article>
    </div>
  </div>
</BaseLayout>
