---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("help")).sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
);
---

<BaseLayout title="Help Centre | GymOS" description="GymOS help centre articles for setup, billing, and operational onboarding.">
  <div class="page-wrap">
    <div class="container page-stack">
      <section class="page-hero">
        <span class="eyebrow">Help Centre</span>
        <h1>Setup notes for teams putting GymOS into daily use.</h1>
        <p>
          Documentation written for owners, admins, and operations teams moving from
          manual processes into structured workflows.
        </p>
      </section>

      <section class="section-shell">
        <div class="list-grid">
          {articles.map((article) => (
            <article class="list-card">
              <span class="card-tag">{article.data.audience}</span>
              <h3><a href={`/help-centre/${article.slug}`}>{article.data.title}</a></h3>
              <p>{article.data.description}</p>
              <div class="meta-row">
                <span>Updated {article.data.updatedAt.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
