SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_GYM_PHOTO_BUCKET="gym-photos"
SUPABASE_PLAN_PDF_BUCKET="plan-files"
SESSION_COOKIE_SECRET="replace-with-a-long-random-secret"
SESSION_COOKIE_SAME_SITE="lax"
SESSION_COOKIE_SECURE="false"
SESSION_COOKIE_PARTITIONED="false"
# SESSION_COOKIE_DOMAIN=".yourdomain.com"

# Origin of the web app for CORS, e.g. http://localhost:8080
FRONTEND_URL="http://localhost:8080"
BACKEND_PUBLIC_URL="http://localhost:3001"

# Rate limiting
# Set TRUST_PROXY when running behind a reverse proxy/load balancer so req.ip is correct.
TRUST_PROXY="false"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="300"
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_RATE_LIMIT_MAX_REQUESTS="20"

# Optional Twilio WhatsApp configuration
# TWILIO_ACCOUNT_SID="your_twilio_account_sid"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
#
ONBOARDING_PAYMENTS_ENABLED="false"
DODO_PAYMENTS_ENV="test"
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_SECRET=""
DODO_PAYMENTS_CURRENCY="INR"
DODO_PAYMENTS_COUNTRY="IN"
DODO_PRODUCT_STARTER_MONTHLY=""
DODO_PRODUCT_STARTER_YEARLY=""
DODO_PRODUCT_GROWTH_MONTHLY=""
DODO_PRODUCT_GROWTH_YEARLY=""
DODO_PRODUCT_SCALE_MONTHLY=""
DODO_PRODUCT_SCALE_YEARLY=""

# Resend Keys
PASSWORD_RESET_REDIRECT_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
