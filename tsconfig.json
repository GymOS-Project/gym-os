{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "*": ["./*"],
      "@/*": [
        "./apps/web/src/*"
      ]
    },
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "./apps/**/*.ts",
    "./apps/**/*.tsx"
  ],
  "references": []
}
